# Copy to .env and fill in your own values. Never commit .env or paste real
# values from here into a shared chat, README, or commit message.

# MongoDB Atlas connection string.
MONGO_URI=

# Signs every role's JWT (doctor, receptionist, nurse, lab technician, admin,
# patient). No fallback exists in code — if this is unset, auth fails closed
# rather than signing with a guessable default. Use a long random string.
JWT_SECRET=

# Defaults to 5000 if unset.
PORT=5000

# Bootstrap admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated browser origins the API accepts CORS requests from, e.g.
# http://localhost:5173,https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Patient Google sign-in.
GOOGLE_CLIENT_ID=

# Symptom -> specialization matching. Tried in this order; either key may be
# left blank and the feature falls through to the next provider.
OPENAI_API_KEY=
GROQ_API_KEY=

# Outbound mail. Resend is preferred - Render blocks outbound SMTP ports, so
# SMTP_USER/SMTP_PASS will not work when deployed there.
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173
